# SPDX-License-Identifier: BSD-3-Clause
# Enabled by the package since 0.2.28 (ladder A.3c N5 passed on 2026-11-03);
# the conditions below keep it idle until the kernel exposes pen_uplink, and
# the daemon itself waits for the bonded pen (bonded once with bluetoothctl).
[Unit]
Description=OnePlus Pad 4: pen handshake bridge (Stylo Pro over Bluetooth)
After=bluetooth.service
Requires=bluetooth.service
ConditionPathExists=/etc/iceland/pen.conf
ConditionPathExists=/sys/bus/spi/devices/spi0.0/pen_uplink

[Service]
Type=simple
ExecStart=/usr/libexec/iceland/iceland-pen
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
