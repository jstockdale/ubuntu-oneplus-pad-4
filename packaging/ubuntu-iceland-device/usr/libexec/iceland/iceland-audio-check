#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
# OnePlus Pad 4: after boot, confirm the sound card registered; if not, say
# which modules of the audio chain are missing, load them, and report the
# outcome. Never fails the boot. Every line goes to the journal under the
# tag iceland-audio-check so a census can count the misses:
#   journalctl -t iceland-audio-check
# Background: on 2026-11-02 one boot came up with four chain modules not
# loaded although udev had processed their devices; see
# /usr/lib/modules-load.d/iceland-audio.conf, which now loads the set
# deterministically. This unit is the witness and the second net.
set -u

CARD=OnePlusPad4
LIST=/usr/lib/modules-load.d/iceland-audio.conf
WAIT_PRESENT=${ICELAND_AUDIO_WAIT:-40}
WAIT_REPAIR=${ICELAND_AUDIO_REPAIR_WAIT:-30}

# logger only: the unit's stdout also lands in the journal under this
# identifier, so echoing every line as well recorded each one twice (0.2.30)
log() { logger -t iceland-audio-check -p "user.$1" -- "$2"; }
uptime_s() { cut -d' ' -f1 /proc/uptime; }
card_present() { grep -q "\[$CARD" /proc/asound/cards 2>/dev/null; }
wait_for_card() {
	i=0
	while [ "$i" -lt "$1" ]; do
		card_present && return 0
		sleep 1; i=$((i + 1))
	done
	card_present
}

# The second net (0.2.29): the card can register while WirePlumber's first
# pass over it is already under way; its UCM profile then fails to attach
# and the card sits on "off"/"pro-audio" with no sink (seen on the first
# boot of kernel #45, 2026-11-03: card at 8.24 s, WirePlumber's pass at
# 8.28 s). A WirePlumber restart attaches HiFi. Check the owner's session
# for an ALSA sink once it is up and restart WirePlumber once if none.
check_session_sink() {
	for uid_dir in /run/user/*; do
		uid=$(basename "$uid_dir")
		# Only the owner's session (the regular-user range of login.defs).
		# The GDM greeter runs as a dynamic user: its WirePlumber cannot
		# take the card while the owner's session holds it, and systemd-run
		# cannot resolve the uid, so the greeter check logged a false
		# "still no ALSA sink" and left two failed transient units (0.2.30).
		case "$uid" in ''|*[!0-9]*) continue ;; esac
		[ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] || continue
		user=$(getent passwd "$uid" | cut -d: -f1)
		[ -n "$user" ] || continue
		[ -S "$uid_dir/pipewire-0" ] || continue
		if ! systemd-run --quiet --wait --pipe --uid="$uid" --gid="$uid" \
			-E XDG_RUNTIME_DIR="$uid_dir" wpctl status 2>/dev/null | grep -q 'alsa_output\|Speakers (raw'; then
			log warning "session of $user has no ALSA sink for $CARD at $(uptime_s) s; restarting WirePlumber once"
			systemctl --user -M "$user@" restart wireplumber.service 2>&1 | logger -t iceland-audio-check -p user.warning
			sleep 6
			if systemd-run --quiet --wait --pipe --uid="$uid" --gid="$uid" \
				-E XDG_RUNTIME_DIR="$uid_dir" wpctl status 2>/dev/null | grep -q 'alsa_output\|Speakers (raw'; then
				log warning "ALSA sink present after the WirePlumber restart"
			else
				log err "still no ALSA sink after the WirePlumber restart"
			fi
		else
			log info "session of $user has its ALSA sink"
		fi
	done
}

if wait_for_card "$WAIT_PRESENT"; then
	log info "sound card $CARD present at $(uptime_s) s"
	# the session comes up after this unit; give it time, then verify
	i=0
	while [ "$i" -lt 60 ] && ! ls /run/user/*/pipewire-0 >/dev/null 2>&1; do sleep 2; i=$((i + 1)); done
	sleep 8
	check_session_sink
	exit 0
fi

missing=""
for m in $(grep -vE '^\s*(#|$)' "$LIST" 2>/dev/null); do
	grep -q "^$m " /proc/modules || missing="$missing $m"
done
deferred=$(cat /sys/kernel/debug/devices_deferred 2>/dev/null | tr '\n' ';')
log warning "sound card $CARD absent at $(uptime_s) s; chain modules not loaded:${missing:- none}; deferred: ${deferred:-none}"

for m in $missing; do
	modprobe "$m" 2>&1 | logger -t iceland-audio-check -p user.warning
done

if wait_for_card "$WAIT_REPAIR"; then
	log warning "sound card $CARD recovered at $(uptime_s) s after loading:${missing:- nothing}"
else
	log err "sound card $CARD still absent at $(uptime_s) s; deferred: $(cat /sys/kernel/debug/devices_deferred 2>/dev/null | tr '\n' ';')"
fi
exit 0
