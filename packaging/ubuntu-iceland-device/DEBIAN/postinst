#!/bin/sh
# SPDX-License-Identifier: BSD-3-Clause
set -e

case "$1" in
	configure)
		# 0.2.7..0.2.8 shipped a watchdog feeder as a conffile; dpkg
		# leaves dropped conffiles on disk, and an obsolete feeder in
		# the hook dir would ride into every initramfs. Remove it.
		rm -f /etc/initramfs-tools/scripts/init-top/iceland-watchdog
		# The 30-module parade blacklist was hand-written on-device
		# during the 2026-10-31 bisect; the packaged 2-line policy in
		# /usr/lib/modprobe.d/iceland.conf replaces it.
		rm -f /etc/modprobe.d/iceland-parade.conf
		# The grow service is enabled by the rootfs build for images; this
		# covers an apt (re)install on a running device.  Guarded: postinst
		# also runs inside mmdebstrap's chroot, where systemctl enable works
		# but start would not.
		if command -v systemctl >/dev/null 2>&1; then
			# Pick up unit drop-ins (serial-getty@ttyGS0) on a live
			# system; fails harmlessly in a build chroot (no pid 1).
			systemctl daemon-reload >/dev/null 2>&1 || true
			# Apply .network changes (usb0 route/DNS) immediately.
			networkctl reload >/dev/null 2>&1 || true
			systemctl enable ubuntu-iceland-grow-rootfs.service >/dev/null 2>&1 || true
			# The gadget unit, its getty, and networkd for usb0: the only
			# access path on a headless first boot.
			systemctl enable ubuntu-iceland-usb-gadget.service >/dev/null 2>&1 || true
			systemctl enable serial-getty@ttyGS0.service >/dev/null 2>&1 || true
			systemctl enable systemd-networkd.service >/dev/null 2>&1 || true
			# 0.2.18: the protected "Speakers" filter-chain sink becomes each
			# account's configured default output (WirePlumber 0.5 does not
			# pick filter sinks by priority alone). Global user-unit enable.
			systemctl --global enable iceland-speaker-default.service >/dev/null 2>&1 || true
			# 0.2.20: the kernel's qcom_pd_mapper answers the ADSP's domain
			# query for this SoC; Ubuntu's userspace pd-mapper (only adspr.jsn
			# here) raced it and, when first, left the audio PD unpublished
			# (PDR "service lookup for avs/audio failed: -6", never retried).
			# qrtr-ns is the kernel name service's dormant twin. Masked, not
			# removed, so the packages can stay installed.
			systemctl mask pd-mapper.service qrtr-ns.service >/dev/null 2>&1 || true
			# 0.2.21 (C5 guards): suspend is untested on this board and fwupd
			# must never run here (see /etc/apt/preferences.d/90-iceland-no-fwupd);
			# masking units that are not installed is harmless and sticks.
			systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target >/dev/null 2>&1 || true
			systemctl mask fwupd.service fwupd.socket fwupd-refresh.timer fwupd-refresh.service >/dev/null 2>&1 || true
		fi
		# 0.2.21: compile the dconf system db when dconf is present (it is not
		# on the minimal profile; the desktop install runs dconf's own trigger).
		if command -v dconf >/dev/null 2>&1; then
			dconf update >/dev/null 2>&1 || true
		fi
		# A changed conf.d must reach the installed initramfs; harmless in
		# the image build, where make-initramfs.sh regenerates anyway.
		if command -v update-initramfs >/dev/null 2>&1 && \
			[ -d /lib/modules ] && [ -n "$(ls -A /lib/modules 2>/dev/null)" ]; then
			update-initramfs -u || true
		fi
		;;
esac

exit 0
