#!/bin/sh
# Feed the ABL-armed, probe-re-armed watchdog from the first second of
# userspace until systemd takes ownership (RuntimeWatchdogSec, shipped
# alongside): the kernel's auto-feed worker does not engage on this
# hardware. Each open-write-close is a ping; once systemd holds the
# device our open fails EBUSY and the loop idles harmlessly.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
	prereqs) prereqs; exit 0 ;;
esac
# The exact pattern flights 15-18 survived on for minutes: the magic
# character every two seconds (each open-V-close asks the core to stop
# the dog; where the hardware refuses, it still counts as a ping).
# printf-1 every 5 s plus a systemd RuntimeWatchdogSec were both tried
# and measurably died earlier; stay with what the hardware accepts.
(
	while :; do
		for w in /dev/watchdog0 /dev/watchdog; do
			[ -e "$w" ] && printf V > "$w" 2>/dev/null
		done
		sleep 2
	done
) 2>/dev/null &
exit 0
