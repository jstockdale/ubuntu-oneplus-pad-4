#!/bin/sh
# Trim the generated initramfs to fit iceland's 8 MiB init_boot partition.
# Runs last (zz-). Measured on the first oversized build (13.2 MB packed,
# 37 MB raw): the weight was never kernel modules but stock Ubuntu payload
# this initramfs cannot use —
#   udev/hwdb.bin   13.8 MB  device METADATA lookup; udevd creates nodes
#                            and runs rules fine without it
#   dhcpcd          ~0.9 MB  netboot support; this device mounts a local
#                            ext4 root by label, BOOT=local always
#   loadkeys etc    ~0.3 MB  console keymaps; KEYMAP=n already set
#   libdevmapper    ~0.5 MB  no LVM/crypt anywhere in this port
#   fuse3           ~0.3 MB  nothing in the boot path mounts FUSE
# Everything removed here is still present in the real root filesystem.
# The udev removal is the big one, and it is by design, verified against
# the shipped scripts: wait_for_udev() no-ops when udevadm is absent,
# resolve_device() maps LABEL= through blkid directly, devtmpfs provides
# the nodes, and local_device_setup's polling loop is the documented
# fallback when wait-for-root is not there. kmod goes with it: a
# zero-module initramfs loads nothing, and kmod was libcrypto's other
# consumer. The closure test proves no kept ELF loses a dependency.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
	prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

for f in \
	usr/lib/udev/hwdb.bin \
	usr/sbin/dhcpcd \
	usr/share/dhcpcd \
	usr/lib/dhcpcd \
	usr/libexec/dhcpcd-hooks \
	usr/libexec/dhcpcd-run-hooks \
	usr/bin/loadkeys \
	usr/share/consolefonts \
	usr/share/keymaps \
	usr/sbin/mount.fuse3 \
	usr/sbin/dmsetup \
	usr/lib/aarch64-linux-gnu/libdevmapper.so.1.02.1 \
	usr/lib/aarch64-linux-gnu/libfuse3.so.* \
	usr/lib/aarch64-linux-gnu/libselinux.so.* \
	usr/lib/aarch64-linux-gnu/libkmod.so.* \
	usr/lib/klibc-*.so \
	usr/lib/aarch64-linux-gnu/dhcpcd \
	usr/lib/modules/*/modules.builtin.modinfo \
	usr/lib/modules/*/modules.builtin.alias.bin \
	usr/bin/udevadm \
	usr/lib/systemd \
	usr/lib/udev \
	etc/udev \
	usr/lib/aarch64-linux-gnu/systemd \
	usr/lib/aarch64-linux-gnu/libcrypto.so.* \
	usr/lib/aarch64-linux-gnu/libudev.so.* \
	usr/lib/aarch64-linux-gnu/libzstd.so.* \
	usr/lib/aarch64-linux-gnu/libpcre2-8.so.* \
	usr/lib/aarch64-linux-gnu/libcrypt.so.* \
	usr/bin/kmod \
	usr/sbin/modprobe usr/sbin/depmod usr/sbin/insmod \
	usr/sbin/rmmod usr/sbin/lsmod usr/sbin/modinfo \
	usr/sbin/wait-for-root \
	scripts/init-top/udev \
	scripts/init-bottom/udev; do
	rm -rf "${DESTDIR:?}/$f"
done
exit 0
