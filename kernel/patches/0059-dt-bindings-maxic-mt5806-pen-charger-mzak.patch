diff --git a/Documentation/devicetree/bindings/power/supply/maxic,mt5806.yaml b/Documentation/devicetree/bindings/power/supply/maxic,mt5806.yaml
new file mode 100644
index 000000000000..98e8fcd540eb
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/maxic,mt5806.yaml
@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/maxic,mt5806.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Maxic MT5806 wireless power transmitter (pen charger)
+
+maintainers:
+  - mzak <mzak.amin@gmail.com>
+
+description:
+  The MT5806 is a small wireless power transmitter. On the OnePlus Pad 4 it
+  charges the pen that sticks to the magnet side of the tablet. It finds the
+  pen by itself; the host switches its supply and decides whether a transfer
+  may go on. The IC is fed from a boost converter that belongs to the charger
+  firmware, which takes the wanted voltage through PMIC GLINK.
+
+properties:
+  compatible:
+    const: maxic,mt5806
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  enable-gpios:
+    description: Power switch of the IC.
+    maxItems: 1
+
+  wake-gpios:
+    description: Keeps the IC awake while active; it sleeps between its looks for a pen otherwise.
+    maxItems: 1
+
+  scan-gpios:
+    description: Active for the short interval between two looks for a pen.
+    maxItems: 1
+
+  tx-off-gpios:
+    description: Switches the transmitter off while active.
+    maxItems: 1
+
+  maxic,boost-idle-microvolt:
+    description: Supply voltage while no pen is attached.
+    minimum: 2000000
+    maximum: 10000000
+
+  maxic,boost-charge-microvolt:
+    description: Supply voltage while a pen is attached.
+    minimum: 2000000
+    maximum: 10000000
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - enable-gpios
+  - wake-gpios
+  - scan-gpios
+  - tx-off-gpios
+  - maxic,boost-idle-microvolt
+  - maxic,boost-charge-microvolt
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        wireless-charger@2b {
+            compatible = "maxic,mt5806";
+            reg = <0x2b>;
+            interrupts-extended = <&tlmm 169 IRQ_TYPE_EDGE_FALLING>;
+            enable-gpios = <&pmic_gpios 8 GPIO_ACTIVE_HIGH>;
+            wake-gpios = <&pmic_gpios 2 GPIO_ACTIVE_HIGH>;
+            scan-gpios = <&pmic_gpios 7 GPIO_ACTIVE_HIGH>;
+            tx-off-gpios = <&pmic_gpios 11 GPIO_ACTIVE_HIGH>;
+            maxic,boost-idle-microvolt = <7000000>;
+            maxic,boost-charge-microvolt = <10000000>;
+            wakeup-source;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/vendor-prefixes.yaml b/Documentation/devicetree/bindings/vendor-prefixes.yaml
index 98ae01633158..05ad69a0f203 100644
--- a/Documentation/devicetree/bindings/vendor-prefixes.yaml
+++ b/Documentation/devicetree/bindings/vendor-prefixes.yaml
@@ -1033,6 +1033,8 @@ patternProperties:
     description: Marvell Technology Group Ltd.
   "^maxbotix,.*":
     description: MaxBotix Inc.
+  "^maxic,.*":
+    description: Maxic Technology, Inc.
   "^maxim,.*":
     description: Maxim Integrated Products
   "^maxlinear,.*":
