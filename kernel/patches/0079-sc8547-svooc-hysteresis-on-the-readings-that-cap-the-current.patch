+}
+
+static void sc8547_direct_test_cold(struct kunit *test)
+{
+	enum sc8547_direct_cold cold = SC8547_DIRECT_WARM;
+	int taper = 6200000;
+
+	/* From a warm cell, a row is entered half a degree below its boundary. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(210, &cold), 6200000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(205, &cold), 6200000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(204, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, cold, SC8547_DIRECT_COOL);
+	/* Readings at the boundary no longer move it; it is left half a degree above. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(209, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(210, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(214, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(215, &cold), 6200000);
+	KUNIT_EXPECT_EQ(test, cold, SC8547_DIRECT_WARM);
+	/* Down into the cold row and back up through the cool one. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(115, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(114, &cold), 2500000);
+	KUNIT_EXPECT_EQ(test, cold, SC8547_DIRECT_COLD);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(124, &cold), 2500000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(125, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, cold, SC8547_DIRECT_COOL);
+	/* Straight from cold to warm, and from warm to cold. */
+	cold = SC8547_DIRECT_COLD;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(215, &cold), 6200000);
+	KUNIT_EXPECT_EQ(test, cold, SC8547_DIRECT_WARM);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_cold_ua(100, &cold), 2500000);
+	KUNIT_EXPECT_EQ(test, cold, SC8547_DIRECT_COLD);
+	/* The rows reach the thermal allowance with the state carried along. */
+	cold = SC8547_DIRECT_WARM;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_thermal_ua(250, cool_mc, 200, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_thermal_ua(250, cool_mc, 212, &cold), 4000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_thermal_ua(250, cool_mc, 215, &cold), 6200000);
+
+	/*
+	 * The deadband on the readings' caps: 55 W at 8.86 V is 6.21 A, 6.1 A
+	 * after the offset, within 150 mA of the applied 6.0 A, so 6.0 A stays;
+	 * at 8.70 V the budget clears the deadband and 6.2 A is asked for; at
+	 * 8.88 V it is 6.09 A, within 50 mA below the applied 6.1 A, which
+	 * stays; at 8.95 V it is 6.04 A, which lowers it to 6.0 A.
+	 */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8860000, 5000000, 6000000), 6000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8700000, 5000000, 6000000), 6200000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8880000, 5000000, 6100000), 6100000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8950000, 5000000, 6100000), 6000000);
+	/*
+	 * A 140 mV wander of the bus around 8.88 V no longer moves a 6.0 A
+	 * request: 8.81 V (6.14 A) and 8.95 V (6.04 A) both leave it; 8.80 V
+	 * (6.15 A) is the edge of the deadband and raises it.
