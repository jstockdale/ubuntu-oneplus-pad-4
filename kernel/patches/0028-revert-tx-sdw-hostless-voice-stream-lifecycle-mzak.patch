From: jstockdale <jstockdale@gmail.com>
Subject: [PATCH] Revert the sdw.c hunks of perpetua "hostless modem voice"

Perpetua/denialwm commit 7c8cc30d7fc4 ("ASoC: qcom: hostless modem
voice through q6apm") added a SoundWire stream-lifecycle change to
sound/soc/qcom/sdw.c: an -EBUSY guard in qcom_snd_sdw_startup that
aborts if a codec DAI stream is already active, an err-path
set_stream(NULL) clearing loop, and a set_stream(NULL) clearing loop
in qcom_snd_sdw_shutdown. This wedges the WCD9395 SoundWire codec-DMA
data path: capture (swr2) and WCD headphone playback (swr1) both start
but transfer no data (hw_ptr frozen, EIO, intermittent SWRM read-FIFO
underflow, wcd_tx slave stuck in ALERT). The TDM speaker path does not
use sdw.c and is unaffected.

The denialwm project's own FEATURES.md records this as a regression on
iceland, aston and nx809j ("capture starts but no data arrives; suspect
7c8cc30d7fc4"); upstream v7.3 and the Fedora iceland port carry none of
it and capture cleanly. Revert only the sdw.c hunks (the codec-DMA
differentiator); the voice frontend files are left in place (gated off
on iceland). Verified the result equals upstream v7.3 sdw.c
(qcom_snd_sdw_startup + qcom_snd_sdw_shutdown).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
diff --git a/sound/soc/qcom/sdw.c b/sound/soc/qcom/sdw.c
index c7a4a53fe6ee..6576b47a4c8c 100644
--- a/sound/soc/qcom/sdw.c
+++ b/sound/soc/qcom/sdw.c
@@ -74,13 +74,6 @@ int qcom_snd_sdw_startup(struct snd_pcm_substream *substream)
 	if (!qcom_snd_is_sdw_dai(cpu_dai->id))
 		return 0;
 
-	/* A failed second open must not replace a live codec's stream. */
-	for_each_rtd_codec_dais(rtd, i, codec_dai) {
-		if (codec_dai->driver->ops && codec_dai->driver->ops->set_stream &&
-		    snd_soc_dai_stream_active(codec_dai, substream->stream))
-			return -EBUSY;
-	}
-
 	sruntime = sdw_alloc_stream(cpu_dai->name, SDW_STREAM_PCM);
 	if (!sruntime)
 		return -ENOMEM;
@@ -124,13 +117,6 @@ int qcom_snd_sdw_startup(struct snd_pcm_substream *substream)
 	return 0;
 
 err_set_stream:
-	/* A failed link startup is not followed by the link's shutdown. */
-	for_each_rtd_codec_dais(rtd, j, codec_dai) {
-		if (j > i)
-			break;
-		if (codec_dai->driver->ops && codec_dai->driver->ops->set_stream)
-			snd_soc_dai_set_stream(codec_dai, NULL, substream->stream);
-	}
 	sdw_release_stream(sruntime);
 
 	return ret;
@@ -201,17 +187,8 @@ EXPORT_SYMBOL_GPL(qcom_snd_sdw_get_stream);
 
 void qcom_snd_sdw_shutdown(struct snd_pcm_substream *substream)
 {
-	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct sdw_stream_runtime *sruntime = qcom_snd_sdw_get_stream(substream);
-	struct snd_soc_dai *codec_dai;
-	int i;
 
-	if (!qcom_snd_is_sdw_dai(snd_soc_rtd_to_cpu(rtd, 0)->id))
-		return;
-	for_each_rtd_codec_dais(rtd, i, codec_dai) {
-		if (codec_dai->driver->ops && codec_dai->driver->ops->set_stream)
-			snd_soc_dai_set_stream(codec_dai, NULL, substream->stream);
-	}
 	sdw_release_stream(sruntime);
 }
 EXPORT_SYMBOL_GPL(qcom_snd_sdw_shutdown);
