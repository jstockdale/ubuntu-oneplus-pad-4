diff --git a/drivers/power/supply/sc8547_direct_policy.c b/drivers/power/supply/sc8547_direct_policy.c
new file mode 100644
index 0000000..1da8d61
--- /dev/null
+++ b/drivers/power/supply/sc8547_direct_policy.c
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Current and voltage envelope of direct charging through SC8547D pumps.
+ *
+ * Limits adapted from the Oplus SC8547D driver, Copyright (C) 2018-2023
+ * Oplus. All rights reserved. The adapter protocol that regulates the
+ * current is the session driver's business; this library only says how
+ * much the battery, the board and the pumps allow, from plain readings.
+ */
+#include <linux/errno.h>
+#include <linux/math.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/power_supply.h>
+
+#include "sc8547_direct_policy.h"
+
+const struct sc8547_direct_limit sc8547_direct_therm_limits[SC8547_DIRECT_THERMS] = {
+	[SC8547_DIRECT_USB_CONNECTOR] = { 60000, 70000 },
+	[SC8547_DIRECT_BATTERY_CONNECTOR] = { 60000, 70000 },
+	[SC8547_DIRECT_BOARD] = { 45000, 55000 },
+	[SC8547_DIRECT_MOS] = { 60000, 70000 },
+};
+EXPORT_SYMBOL_GPL(sc8547_direct_therm_limits);
+
+/**
+ * sc8547_direct_scale() - derate linearly between two temperatures
+ * @value: the temperature
+ * @soft: the temperature up to which the full current is allowed
+ * @hard: the temperature from which none is
+ *
+ * Return: the current allowed, in uA.
+ */
+int sc8547_direct_scale(int value, int soft, int hard)
+{
+	if (value <= soft)
+		return SC8547_DIRECT_MAX_UA;
+	if (value >= hard)
+		return 0;
+	return div_s64((s64)SC8547_DIRECT_MAX_UA * (hard - value), hard - soft);
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_scale);
+
+/**
+ * sc8547_direct_thermal_ua() - the current the temperatures allow
+ * @die: the hotter pump die, in tenths of a degree Celsius
+ * @therm_mc: the thermistors, in m°C, in enum sc8547_direct_therm order
+ * @bat_temp: the cell, in tenths of a degree Celsius
+ *
+ * The battery keeps 1.5 A up to 44 °C and is held to 2.5 A below 21 °C.
+ *
+ * Return: the current allowed, in uA.
+ */
+int sc8547_direct_thermal_ua(int die, const int *therm_mc, int bat_temp)
+{
+	int ua, i;
+
+	ua = sc8547_direct_scale(die, 600, SC8547_DIRECT_DIE_MAX_DC);
+	for (i = 0; i < SC8547_DIRECT_THERMS; i++)
+		ua = min(ua, sc8547_direct_scale(therm_mc[i],
+						 sc8547_direct_therm_limits[i].soft,
+						 sc8547_direct_therm_limits[i].hard));
+	if (bat_temp < SC8547_DIRECT_CELL_MAX_DC)
+		ua = min(ua, max(sc8547_direct_scale(bat_temp, 380, SC8547_DIRECT_CELL_MAX_DC),
+				 SC8547_DIRECT_MIN_UA));
+	else
+		ua = 0;
+	if (bat_temp < 210)
+		ua = min(ua, 2500000);
+	return ua;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_thermal_ua);
+
+/**
+ * sc8547_direct_taper_ua() - the current the battery voltage allows
+ * @uv: the battery voltage, see sc8547_direct_vbat_uv()
+ *
+ * Return: 4.0, 3.0, 2.0 and 1.5 A from 4.40, 4.42, 4.44 and 4.46 V; the full
+ * current below.
+ */
+int sc8547_direct_taper_ua(int uv)
+{
+	if (uv >= 4460000)
+		return 1500000;
+	if (uv >= 4440000)
+		return 2000000;
+	if (uv >= 4420000)
+		return 3000000;
+	if (uv >= 4400000)
+		return 4000000;
+	return SC8547_DIRECT_MAX_UA;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_taper_ua);
+
+/**
+ * sc8547_direct_admissible() - whether a session may start
+ * @bat: the battery
+ * @therm_mc: the thermistors, negative when unread
+ *
+ * Return: true when every entry condition holds.
+ */
+bool sc8547_direct_admissible(const struct sc8547_direct_battery *bat,
+			      const int *therm_mc)
+{
+	int i;
+
+	if (bat->health != POWER_SUPPLY_HEALTH_GOOD ||
+	    bat->capacity >= SC8547_DIRECT_CAPACITY_END ||
+	    bat->temp < 150 || bat->temp >= SC8547_DIRECT_CELL_MAX_DC ||
+	    bat->uv < 3300000 || bat->uv >= 4400000)
+		return false;
+	for (i = 0; i < SC8547_DIRECT_THERMS; i++)
+		if (therm_mc[i] < 0 || therm_mc[i] >= sc8547_direct_therm_limits[i].soft)
+			return false;
+	return true;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_admissible);
+
+/**
+ * sc8547_direct_entry_ua() - the session's current, chosen from the charge level
+ * @bat: the battery
+ * @therm_mc: the thermistors
+ * @die: the hotter pump die, in tenths of a degree Celsius
+ *
+ * Return: the current in whole 100 mA steps, which may be below the minimum;
+ * 0 for a gauge reading at or below -0.35 V, where the top of the VBUS window
+ * would not be positive.
+ */
+int sc8547_direct_entry_ua(const struct sc8547_direct_battery *bat,
+			   const int *therm_mc, int die)
+{
+	int ua = bat->capacity <= 55 ? SC8547_DIRECT_MAX_UA :
+		 bat->capacity < 85 ? 3000000 : 2000000;
+
+	ua = min(ua, sc8547_direct_thermal_ua(die, therm_mc, bat->temp));
+	ua = min(ua, sc8547_direct_taper_ua(bat->uv));
+	/* Within the power budget at the top of the VBUS window. */
+	if (2 * bat->uv + 700000 <= 0)
+		return 0;
+	ua = min_t(int, ua, div_s64(SC8547_DIRECT_POWER_UW * 1000000,
+				    2 * bat->uv + 700000));
+	return ua / 100000 * 100000;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_entry_ua);
+
+/**
+ * sc8547_direct_regulate_target_ua() - the current to ask for while running
+ * @limit_ua: the session's limit
+ * @taper_ua: the taper reached so far; lowered here, never raised
+ * @vbat_uv: the battery voltage, see sc8547_direct_vbat_uv()
+ * @thermal_ua: what the temperatures allow, see sc8547_direct_thermal_ua()
+ * @vbus_uv: the main pump's input voltage, which the running window of
+ *	sc8547_direct_running_ok() keeps near twice the battery voltage
+ * @ibus_ua: the pumps' total input current
+ * @applied_ua: the current the adapter was last asked for
+ *
+ * Return: the current in whole 100 mA steps, which may be below the minimum;
+ * 0 when @vbus_uv is not positive.
+ */
+int sc8547_direct_regulate_target_ua(int limit_ua, int *taper_ua, int vbat_uv,
+				     int thermal_ua, int vbus_uv, int ibus_ua,
+				     int applied_ua)
+{
+	s64 power = (s64)vbus_uv * ibus_ua;
+	int ua;
+
+	if (vbus_uv <= 0)
+		return 0;
+	*taper_ua = min(*taper_ua, sc8547_direct_taper_ua(vbat_uv));
+	ua = min(limit_ua, *taper_ua);
+	ua = min(ua, thermal_ua);
+	ua = min_t(int, ua, div_s64(SC8547_DIRECT_POWER_UW * 1000000, vbus_uv) - 100000);
+	if (power > SC8547_DIRECT_POWER_UW * 1000000)
+		ua = min_t(int, ua, applied_ua - 100000 -
+			   div_s64(power - SC8547_DIRECT_POWER_SETTLE_UW * 1000000,
+				   vbus_uv));
+	return ua / 100000 * 100000;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_regulate_target_ua);
+
+/**
+ * sc8547_direct_running_ok() - the checks on the pumps while they switch
+ * @main: the main pump
+ * @second: the second pump
+ * @vbat_uv: the gauge's battery voltage
+ * @limit_ua: the session's limit
+ * @second_on: the second pump has been enabled
+ * @dual: both pumps share the current
+ * @disagree: how many samples in a row the pumps' VBUS disagreed, kept by
+ *	the caller and updated here
+ *
+ * VBUS is held against the gauge's voltage, not against the pump's own
+ * sense of the battery.
+ *
+ * Return: 0, -EIO when a pump that should switch does not, -ERANGE when a
+ * voltage, a current or the power left its window.
+ */
+int sc8547_direct_running_ok(const struct sc8547_sample *main,
+			     const struct sc8547_sample *second, int vbat_uv,
+			     int limit_ua, bool second_on, bool dual,
+			     unsigned int *disagree)
+{
+	int ibus = main->ibus_ua + (second_on ? second->ibus_ua : 0);
+	s64 power = (s64)main->vbus_uv * ibus;
+
+	if (!main->switching)
+		return -EIO;
+	if (main->vbus_uv < 2 * vbat_uv - 100000 || main->vbus_uv > 2 * vbat_uv + 700000)
+		return -ERANGE;
+	if (ibus > limit_ua + 300000 || main->ibus_ua > SC8547_DIRECT_PUMP_MAX_UA ||
+	    (!dual && ibus > SC8547_DIRECT_PUMP_MAX_UA) ||
+	    power > SC8547_DIRECT_POWER_MAX_UW * 1000000)
+		return -ERANGE;
+	if (second_on && second->ibus_ua > SC8547_DIRECT_PUMP_MAX_UA)
+		return -ERANGE;
+	/* The pumps are sampled in turn: one pair may straddle a step. */
+	if (second_on && abs(second->vbus_uv - main->vbus_uv) > 250000) {
+		if (++*disagree > 1)
+			return -ERANGE;
+	} else {
+		*disagree = 0;
+	}
+	if (dual && !second->switching)
+		return -EIO;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_running_ok);
+
+/**
+ * sc8547_direct_second_join() - the main pump carries enough to share
+ * @main: the main pump
+ * @second: the second pump, prepared and not yet enabled
+ *
+ * Return: true when the main pump carries more than 1.4 A and the two pumps'
+ * VBUS agree within 250 mV.
+ */
+bool sc8547_direct_second_join(const struct sc8547_sample *main,
+			       const struct sc8547_sample *second)
+{
+	return main->ibus_ua > SC8547_DIRECT_SECOND_UA &&
+	       abs(second->vbus_uv - main->vbus_uv) <= 250000;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_second_join);
+
+/**
+ * sc8547_direct_second_shared() - both pumps carry their share
+ * @main: the main pump
+ * @second: the second pump, enabled
+ *
+ * Return: true when the second pump switches and each pump carries at least
+ * 0.5 A, within 1 A of the other.
+ */
+bool sc8547_direct_second_shared(const struct sc8547_sample *main,
+				 const struct sc8547_sample *second)
+{
+	return second->switching && main->ibus_ua >= 500000 &&
+	       second->ibus_ua >= 500000 &&
+	       abs(main->ibus_ua - second->ibus_ua) <= 1000000;
+}
+EXPORT_SYMBOL_GPL(sc8547_direct_second_shared);
+
+MODULE_DESCRIPTION("Direct charging envelope for the SC8547D charge pumps");
+MODULE_LICENSE("GPL");
diff --git a/drivers/power/supply/sc8547_direct_policy.h b/drivers/power/supply/sc8547_direct_policy.h
new file mode 100644
index 0000000..d517d1a
--- /dev/null
+++ b/drivers/power/supply/sc8547_direct_policy.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SC8547_DIRECT_POLICY_H
+#define _SC8547_DIRECT_POLICY_H
+
+#include <linux/minmax.h>
+#include <linux/power/sc8547.h>
+#include <linux/types.h>
+
+/* A 2:1 pump and its battery path as qualified on this board. */
+#define SC8547_DIRECT_MAX_UA		6200000
+#define SC8547_DIRECT_PUMP_MAX_UA	3300000
+#define SC8547_DIRECT_MIN_UA		1500000
+#define SC8547_DIRECT_POWER_UW		55000000LL
+#define SC8547_DIRECT_POWER_MAX_UW	60000000LL
+#define SC8547_DIRECT_VBAT_MAX_UV	4480000
+#define SC8547_DIRECT_SECOND_UA		1400000
+/* Hard stops: the cell and the pump die, in tenths of a degree Celsius. */
+#define SC8547_DIRECT_CELL_MAX_DC	440
+#define SC8547_DIRECT_DIE_MAX_DC	700
+/* Over the budget, the current steps down to land the power here. */
+#define SC8547_DIRECT_POWER_SETTLE_UW	54500000LL
+/* A session ends normally at this charge level, in percent. */
+#define SC8547_DIRECT_CAPACITY_END	90
+
+enum sc8547_direct_therm {
+	SC8547_DIRECT_USB_CONNECTOR,
+	SC8547_DIRECT_BATTERY_CONNECTOR,
+	SC8547_DIRECT_BOARD,
+	SC8547_DIRECT_MOS,
+	SC8547_DIRECT_THERMS,
+};
+
+/* Full current up to the soft limit, none at the hard limit, in m°C. */
+struct sc8547_direct_limit {
+	int soft;
+	int hard;
+};
+
+extern const struct sc8547_direct_limit sc8547_direct_therm_limits[SC8547_DIRECT_THERMS];
+
+/**
+ * struct sc8547_direct_battery - the gauge's reading of the battery
+ * @uv: voltage.
+ * @ua: current, negative when discharging.
+ * @capacity: charge level in percent.
+ * @temp: cell temperature in tenths of a degree Celsius.
+ * @health: POWER_SUPPLY_HEALTH_* as the gauge reports it.
+ */
+struct sc8547_direct_battery {
+	int uv;
+	int ua;
+	int capacity;
+	int temp;
+	int health;
+};
+
+int sc8547_direct_scale(int value, int soft, int hard);
+int sc8547_direct_thermal_ua(int die, const int *therm_mc, int bat_temp);
+int sc8547_direct_taper_ua(int uv);
+bool sc8547_direct_admissible(const struct sc8547_direct_battery *bat,
+			      const int *therm_mc);
+int sc8547_direct_entry_ua(const struct sc8547_direct_battery *bat,
+			   const int *therm_mc, int die);
+int sc8547_direct_regulate_target_ua(int limit_ua, int *taper_ua, int vbat_uv,
+				     int thermal_ua, int vbus_uv, int ibus_ua,
+				     int applied_ua);
+int sc8547_direct_running_ok(const struct sc8547_sample *main,
+			     const struct sc8547_sample *second, int vbat_uv,
+			     int limit_ua, bool second_on, bool dual,
+			     unsigned int *disagree);
+bool sc8547_direct_second_join(const struct sc8547_sample *main,
+			       const struct sc8547_sample *second);
+bool sc8547_direct_second_shared(const struct sc8547_sample *main,
+				 const struct sc8547_sample *second);
+
+/**
+ * sc8547_direct_vbat_uv() - the battery voltage the taper follows
+ * @gauge_uv: the gauge's reading
+ * @pump_uv: the main pump's reading at its sense pins
+ *
+ * Neither sense point may hide the taper from the other.
+ *
+ * Return: the higher of the two readings.
+ */
+static inline int sc8547_direct_vbat_uv(int gauge_uv, int pump_uv)
+{
+	return max(gauge_uv, pump_uv);
+}
+
+#endif
diff --git a/drivers/power/supply/sc8547_direct_policy_test.c b/drivers/power/supply/sc8547_direct_policy_test.c
new file mode 100644
index 0000000..92dc0a2
--- /dev/null
+++ b/drivers/power/supply/sc8547_direct_policy_test.c
@@ -0,0 +1,591 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * KUnit tests for the direct charging envelope of the SC8547D pumps. The
+ * numbers are those the OnePlus Pad 4 charged with at 51 to 55 W from its
+ * SuperVOOC adapter; every threshold is pinned here so that a change to
+ * the policy is a change to this file.
+ */
+#include <kunit/test.h>
+#include <linux/power_supply.h>
+
+#include "sc8547_direct_policy.h"
+
+/* A cool board: 30 °C on every thermistor, 25 °C on the die and the cell. */
+static const int cool_mc[SC8547_DIRECT_THERMS] = { 30000, 30000, 30000, 30000 };
+
+static const struct sc8547_direct_battery good_battery = {
+	.uv = 3800000,
+	.ua = 2000000,
+	.capacity = 50,
+	.temp = 250,
+	.health = POWER_SUPPLY_HEALTH_GOOD,
+};
+
+static void sc8547_direct_test_constants(struct kunit *test)
+{
+	const struct sc8547_direct_limit *l;
+
+	KUNIT_EXPECT_EQ(test, SC8547_DIRECT_MAX_UA, 6200000);
