+static const struct sc8547_sample main_running = {
+	.ibus_ua = 3000000,
+	.vbus_uv = 8000000,
+	.vout_uv = 4000000,
+	.vbat_uv = 4000000,
+	.temp = 400,
+	.health = POWER_SUPPLY_HEALTH_GOOD,
+	.switching = true,
+};
