+/* 6.2 A up to 55 %, 3 A below 85 %, 2 A from there; then the derates and the 55 W budget. */
+static void sc8547_direct_test_entry(struct kunit *test)
+{
+	struct sc8547_direct_battery bat = good_battery;
+
+	bat.capacity = 0;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 6200000);
+	bat.capacity = 55;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 6200000);
+	bat.capacity = 56;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 3000000);
+	bat.capacity = 84;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 3000000);
+	bat.capacity = 85;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 2000000);
+	bat.capacity = 89;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 2000000);
+
+	/* The budget at the top of the window, 2 x VBAT + 0.7 V. */
+	bat = good_battery;
+	bat.capacity = 55;
+	bat.uv = 4000000;	/* 55 W / 8.7 V = 6.32 A: the ladder binds */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 6200000);
+	bat.uv = 4300000;	/* 55 W / 9.3 V = 5.91 A */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 5900000);
+	bat.uv = 4350000;	/* 55 W / 9.4 V = 5.85 A */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 5800000);
+	bat.uv = 4440000;	/* the taper, 2 A, below the budget's 5.7 A */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 2000000);
+
+	/* The thermal derate, rounded down to 100 mA. */
+	bat = good_battery;
+	bat.capacity = 56;
+	bat.temp = 420;		/* 2.07 A from the cell line */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 2000000);
+	bat.temp = 250;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 650), 3000000);
+	bat.capacity = 55;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 650), 3100000);
+	bat.temp = 200;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 2500000);
+	/* Below the minimum is reported as such: the caller refuses. */
+	bat.temp = 437;		/* 0.31 A from the line; the floor gives 1.5 A */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 1500000);
+	bat.temp = 440;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 0);
+
+	/* A reading that puts the top of the window at or below 0 V is refused. */
+	bat = good_battery;
+	bat.uv = -350000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 0);
+	bat.uv = -1000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_entry_ua(&bat, cool_mc, 0), 0);
+}
+
+/* min(limit, taper, thermal, 55 W / VBUS - 0.1 A), the over-power step, 100 mA steps. */
+static void sc8547_direct_test_regulate(struct kunit *test)
+{
+	int taper = 6200000;
+
+	/* 55 W at 8.0 V allows 6.78 A: the 6.2 A limit binds. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8000000, 1000000, 1000000), 6200000);
+	/* 55 W at 9.0 V: 6.11 A - 0.1 A -> 6.0 A. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       9000000, 1000000, 1000000), 6000000);
+	/* 55 W at 9.6 V: 5.73 A - 0.1 A -> 5.6 A. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       9600000, 1000000, 1000000), 5600000);
+	KUNIT_EXPECT_EQ(test, taper, 6200000);
+
+	/*
+	 * 6.2 A at 9.0 V is 55.8 W: step down from the applied current by
+	 * 0.1 A plus the excess over 54.5 W.
+	 */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       9000000, 6200000, 6200000), 5900000);
+	/*
+	 * The step is taken above 55 W, not at it: 6.25 A at 8.8 V is
+	 * 55.000000 W and leaves the budget's 6.15 A, rounded to 6.1 A; one
+	 * more microampere (8.8 uW over) steps down from the applied 6.2 A by
+	 * 0.1 A plus the 0.5 W over 54.5 W at 8.8 V, to 6.0 A.
+	 */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8800000, 6250000, 6200000), 6100000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8800000, 6250001, 6200000), 6000000);
+
+	/* The thermal allowance binds, and whole 100 mA steps are kept. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 2500000,
+							       8000000, 2500000, 2500000), 2500000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 1450000,
+							       8000000, 1500000, 1500000), 1400000);
+	/* The limit binds. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(3000000, &taper, 4000000, 6200000,
+							       8000000, 3000000, 3000000), 3000000);
+
+	/* The taper is lowered by the battery voltage and never raised again. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4420000, 6200000,
+							       8840000, 3000000, 3000000), 3000000);
+	KUNIT_EXPECT_EQ(test, taper, 3000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       8000000, 3000000, 3000000), 3000000);
+	KUNIT_EXPECT_EQ(test, taper, 3000000);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4460000, 6200000,
+							       8920000, 2000000, 2000000), 1500000);
+	KUNIT_EXPECT_EQ(test, taper, 1500000);
+
+	/* No VBUS is refused, not divided by; the running window stops it first. */
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       0, 0, 1000000), 0);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_regulate_target_ua(6200000, &taper, 4000000, 6200000,
+							       -1, 0, 1000000), 0);
+	KUNIT_EXPECT_EQ(test, taper, 1500000);
+}
