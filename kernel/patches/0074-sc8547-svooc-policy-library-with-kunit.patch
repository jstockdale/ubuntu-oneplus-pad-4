+/* Health Good, below 90 %, cell 15-44 °C, 3.3-4.4 V, every thermistor below soft. */
+static void sc8547_direct_test_admissible(struct kunit *test)
+{
+	struct sc8547_direct_battery bat = good_battery;
+	int mc[SC8547_DIRECT_THERMS];
+	int i;
+
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&good_battery, cool_mc));
+
+	bat.health = POWER_SUPPLY_HEALTH_OVERHEAT;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.health = POWER_SUPPLY_HEALTH_UNKNOWN;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+
+	bat = good_battery;
+	bat.capacity = 89;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.capacity = 90;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.capacity = 0;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&bat, cool_mc));
+
+	bat = good_battery;
+	bat.temp = 149;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.temp = 150;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.temp = 439;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.temp = 440;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+
+	bat = good_battery;
+	bat.uv = 3299999;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.uv = 3300000;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.uv = 4399999;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_admissible(&bat, cool_mc));
+	bat.uv = 4400000;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_admissible(&bat, cool_mc));
+
+	for (i = 0; i < SC8547_DIRECT_THERMS; i++) {
+		memcpy(mc, cool_mc, sizeof(mc));
+		mc[i] = sc8547_direct_therm_limits[i].soft - 1;
+		KUNIT_EXPECT_TRUE_MSG(test, sc8547_direct_admissible(&good_battery, mc),
+				      "thermistor %d just below soft", i);
+		mc[i] = sc8547_direct_therm_limits[i].soft;
+		KUNIT_EXPECT_FALSE_MSG(test, sc8547_direct_admissible(&good_battery, mc),
+				       "thermistor %d at soft", i);
+		/* An unread thermistor is no thermistor. */
+		mc[i] = -1;
+		KUNIT_EXPECT_FALSE_MSG(test, sc8547_direct_admissible(&good_battery, mc),
+				       "thermistor %d unread", i);
+	}
+}
