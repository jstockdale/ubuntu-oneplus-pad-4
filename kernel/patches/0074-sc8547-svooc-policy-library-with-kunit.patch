+/* VBUS within [2 x VBAT - 0.1 V, 2 x VBAT + 0.7 V] of the gauge's voltage. */
+static void sc8547_direct_test_running_window(struct kunit *test)
+{
+	struct sc8547_sample m = main_running, s = {};
+	unsigned int disagree = 0;
+
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), 0);
+	m.vbus_uv = 7899999;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), -ERANGE);
+	m.vbus_uv = 7900000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), 0);
+	m.vbus_uv = 8700000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), 0);
+	m.vbus_uv = 8700001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), -ERANGE);
+
+	/*
+	 * The window is referenced to the gauge, not to the pump's sense of the
+	 * battery: a low pump reading does not shift it, a low gauge reading does.
+	 */
+	m = main_running;
+	m.vbat_uv = 3000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), 0);
+	m.vbat_uv = 4000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 3000000, 6200000, false, false,
+						       &disagree), -ERANGE);
+	m.vbat_uv = 4000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 3650000, 6200000, false, false,
+						       &disagree), 0);
+
+	/* A main pump that is not switching fails before anything else. */
+	m = main_running;
+	m.switching = false;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), -EIO);
+	m.vbus_uv = 12000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), -EIO);
+}
+
+/* Total within limit + 0.3 A, 3.3 A per pump and alone, 60 W. */
+static void sc8547_direct_test_running_current(struct kunit *test)
+{
+	struct sc8547_sample m = main_running, s = main_running;
+	unsigned int disagree = 0;
+
+	m.ibus_ua = 2300000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 2000000, false, false,
+						       &disagree), 0);
+	m.ibus_ua = 2300001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 2000000, false, false,
+						       &disagree), -ERANGE);
+
+	/* The main pump alone may carry 3.3 A. */
+	m.ibus_ua = 3300000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), 0);
+	m.ibus_ua = 3300001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), -ERANGE);
+	/* The main pump's own limit holds with the second one sharing. */
+	s.ibus_ua = 1000000;
+	m.ibus_ua = 3300000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), 0);
+	m.ibus_ua = 3300001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), -ERANGE);
+	/* Until the second pump shares, the total is held to one pump's worth. */
+	m.ibus_ua = 3000000;
+	s.ibus_ua = 400000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), -ERANGE);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), 0);
+	/* The second pump is held to 3.3 A as well. */
+	s.ibus_ua = 3300000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), 0);
+	s.ibus_ua = 3300001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), -ERANGE);
+	s.ibus_ua = 3200000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), 0);
+
+	/* 6.5 A at 9.3 V is 60.45 W; at 9.2 V, 59.8 W. */
+	m.ibus_ua = 3250000;
+	s.ibus_ua = 3250000;
+	m.vbus_uv = 9300000;
+	s.vbus_uv = 9300000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4400000, 6200000, true, true,
+						       &disagree), -ERANGE);
+	m.vbus_uv = 9200000;
+	s.vbus_uv = 9200000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4400000, 6200000, true, true,
+						       &disagree), 0);
+
+	/* A second pump that stopped while sharing. */
+	s.switching = false;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4400000, 6200000, true, true,
+						       &disagree), -EIO);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4400000, 6200000, true, false,
+						       &disagree), -ERANGE);
+
+	/* 60.000000 W, 6.25 A at 9.6 V, passes; one more microampere does not. */
+	s.switching = true;
+	m.ibus_ua = 3125000;
+	s.ibus_ua = 3125000;
+	m.vbus_uv = 9600000;
+	s.vbus_uv = 9600000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4500000, 6200000, true, true,
+						       &disagree), 0);
+	m.ibus_ua = 3125001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4500000, 6200000, true, true,
+						       &disagree), -ERANGE);
+}
+
+/* The pumps' VBUS may disagree by 250 mV, and by more only once. */
+static void sc8547_direct_test_running_disagree(struct kunit *test)
+{
+	struct sc8547_sample m = main_running, s = main_running;
+	unsigned int disagree = 0;
+
+	m.ibus_ua = 1500000;
+	s.ibus_ua = 1500000;
+	s.vbus_uv = 8250000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 0U);
+	s.vbus_uv = 8250001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 1U);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), -ERANGE);
+	KUNIT_EXPECT_EQ(test, disagree, 2U);
+	s.vbus_uv = 7750000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 0U);
+	/* Either side counts, and a sample in agreement forgives the count. */
+	s.vbus_uv = 7749999;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 1U);
+	s.vbus_uv = 8000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 0U);
+	s.vbus_uv = 8250001;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 1U);
+	s.vbus_uv = 8000000;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 0U);
+	/* Without the second pump its sample is not consulted. */
+	s.vbus_uv = 0;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, false, false,
+						       &disagree), 0);
+	KUNIT_EXPECT_EQ(test, disagree, 0U);
+
+	/*
+	 * The disagreement is counted before a stopped second pump is seen:
+	 * the first such sample stops with -EIO, the second with -ERANGE.
+	 */
+	s = main_running;
+	s.ibus_ua = 1500000;
+	s.switching = false;
+	s.vbus_uv = 8250001;
+	disagree = 0;
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), -EIO);
+	KUNIT_EXPECT_EQ(test, disagree, 1U);
+	KUNIT_EXPECT_EQ(test, sc8547_direct_running_ok(&m, &s, 4000000, 6200000, true, true,
+						       &disagree), -ERANGE);
+	KUNIT_EXPECT_EQ(test, disagree, 2U);
+}
+
+/* The second pump joins above 1.4 A with VBUS agreeing, and shares from 0.5 A each within 1 A. */
+static void sc8547_direct_test_second(struct kunit *test)
+{
+	struct sc8547_sample m = main_running, s = {};
+
+	s.vbus_uv = 8000000;
+	m.ibus_ua = 1400000;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_join(&m, &s));
+	m.ibus_ua = 1400001;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_second_join(&m, &s));
+	s.vbus_uv = 8250000;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_second_join(&m, &s));
+	s.vbus_uv = 8250001;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_join(&m, &s));
+	s.vbus_uv = 7749999;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_join(&m, &s));
+
+	s = main_running;
+	m.ibus_ua = 500000;
+	s.ibus_ua = 500000;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_second_shared(&m, &s));
+	m.ibus_ua = 499999;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_shared(&m, &s));
+	m.ibus_ua = 500000;
+	s.ibus_ua = 499999;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_shared(&m, &s));
+	m.ibus_ua = 1500000;
+	s.ibus_ua = 500000;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_second_shared(&m, &s));
+	m.ibus_ua = 1500001;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_shared(&m, &s));
+	m.ibus_ua = 500000;
+	s.ibus_ua = 1500001;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_shared(&m, &s));
+	s.ibus_ua = 1500000;
+	KUNIT_EXPECT_TRUE(test, sc8547_direct_second_shared(&m, &s));
+	s.switching = false;
+	KUNIT_EXPECT_FALSE(test, sc8547_direct_second_shared(&m, &s));
+}
+
+static struct kunit_case sc8547_direct_test_cases[] = {
+	KUNIT_CASE(sc8547_direct_test_constants),
+	KUNIT_CASE(sc8547_direct_test_scale),
+	KUNIT_CASE(sc8547_direct_test_thermal_die),
+	KUNIT_CASE(sc8547_direct_test_thermal_thermistors),
+	KUNIT_CASE(sc8547_direct_test_thermal_cell),
+	KUNIT_CASE(sc8547_direct_test_taper),
+	KUNIT_CASE(sc8547_direct_test_admissible),
+	KUNIT_CASE(sc8547_direct_test_entry),
+	KUNIT_CASE(sc8547_direct_test_regulate),
+	KUNIT_CASE(sc8547_direct_test_running_window),
+	KUNIT_CASE(sc8547_direct_test_running_current),
+	KUNIT_CASE(sc8547_direct_test_running_disagree),
+	KUNIT_CASE(sc8547_direct_test_second),
+	{}
+};
+
+static struct kunit_suite sc8547_direct_test_suite = {
+	.name = "sc8547-direct-policy",
+	.test_cases = sc8547_direct_test_cases,
+};
+kunit_test_suite(sc8547_direct_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests for the SC8547D direct charging envelope");
+MODULE_LICENSE("GPL");
