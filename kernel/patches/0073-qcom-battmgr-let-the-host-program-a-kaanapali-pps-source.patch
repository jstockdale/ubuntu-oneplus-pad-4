+/*
+ * Called with @battmgr->lock held once the service is up. A restarted
+ * firmware negotiated its PD contract anew and holds its defaults: the
+ * host's suspend vote is gone with the contract it protected.
+ */
+static void qcom_battmgr_oplus_service_up(struct qcom_battmgr *battmgr)
+{
+	int ret;
+
+	qcom_battmgr_oplus_pps_lost(battmgr);
+	battmgr->oplus.pdos_valid = false;
+
+	if (battmgr->oplus.pps_hold) {
+		/*
+		 * A direct charger still owns the input and may have its
+		 * pumps on the bus: vote the suspend again, and leave the
+		 * ramp to its release.
+		 */
+		if (battmgr->oplus.input_suspended) {
+			ret = qcom_battmgr_request_property(battmgr, BATTMGR_OPLUS_PROPERTY_SET,
+							    OPLUS_USB_INPUT_CURRENT_LIMIT, 0);
+			if (ret)
+				dev_err(battmgr->dev, "failed to suspend the input again\n");
+		}
+		return;
+	}
+
+	battmgr->oplus.input_suspended = false;
+
+	/*
+	 * A charger plugged in before the service came up sent its PlugIn
+	 * notification to nobody, so enable charging now.
+	 */
+	schedule_work(&battmgr->oplus_charging_work);
+}
