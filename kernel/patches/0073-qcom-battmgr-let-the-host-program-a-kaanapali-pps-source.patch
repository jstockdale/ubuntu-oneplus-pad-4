+	debugfs_create_file("charging_work", 0200, dir, battmgr,
+			    &qcom_battmgr_oplus_charging_work_fops);
+
+	return devm_add_action_or_reset(battmgr->dev, qcom_battmgr_oplus_debugfs_remove, dir);
+}
