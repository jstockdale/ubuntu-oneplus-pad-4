+/*
+ * Bench diagnostics for the programmable contract: the firmware's
+ * PPS_Status word, and a trigger for the charging work, which writes the
+ * charger enable on every plug event and whose effect on a suspended
+ * input is unverified.
+ */
+static int qcom_battmgr_oplus_pps_status_show(struct seq_file *s, void *data)
+{
+	struct qcom_battmgr *battmgr = s->private;
+	u32 status;
+	int ret;
+
+	if (!battmgr->service_up)
+		return -EAGAIN;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_oplus_get(battmgr, OPLUS_USB_GET_PPS_STATUS, &status);
+	mutex_unlock(&battmgr->lock);
+	if (ret)
+		return ret;
+
+	seq_printf(s, "%#010x %u mV %u mA\n", status,
+		   (status & 0xffff) * 20, ((status >> 16) & 0xff) * 50);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(qcom_battmgr_oplus_pps_status);
