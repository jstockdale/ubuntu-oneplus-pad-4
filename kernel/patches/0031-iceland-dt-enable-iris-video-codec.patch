From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Stockdale <jstockdale@gmail.com>
Date: Mon, 2 Nov 2026 16:55:59 -0800
Subject: [PATCH] arm64: dts: qcom: kaanapali-oneplus-iceland: enable the iris
 video codec

Enable the VPU on the OnePlus Pad 4 with the firmware name the stock
device ships (vpu40_2v.mbn, staged from the owner's own vendor image;
sha256 69d4e215...). The iris driver reads firmware-name index 0 before
falling back to the platform default (qcom/vpu/vpu40_p2.mbn), so no copy
under the generic name is needed. Same four lines as the Fedora iceland
port's board enable.

Signed-off-by: John Stockdale <jstockdale@gmail.com>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    |  43 ++++-
 arch/arm64/boot/dts/qcom/kaanapali.dtsi       | 140 ++++++++++++++-
 drivers/bluetooth/btqca.c                     |   4 +-
 drivers/gpu/drm/msm/dsi/dsi_manager.c         |  24 +--
 .../drm/panel/panel-oneplus-iceland-nt36536.c |  12 +-
 drivers/input/touchscreen/nt36536/nt36xxx.c   |  46 +++--
 .../platform/qcom/iris/iris_platform_common.h |   1 +
 .../qcom/iris/iris_platform_kaanapali.h       |  63 +++++++
 .../platform/qcom/iris/iris_platform_vpu3x.c  |  36 ++++
 drivers/media/platform/qcom/iris/iris_probe.c |   4 +
 drivers/power/sequencing/pwrseq-qcom-wcn.c    |   5 +-
 drivers/soc/qcom/apr.c                        |   6 +-
 drivers/watchdog/qcom-wdt.c                   |  16 +-
 sound/soc/codecs/lpass-tx-macro.c             | 165 ++++--------------
 sound/soc/codecs/tfa9865.c                    | 114 ++++++++----
 sound/soc/qcom/qdsp6/audioreach.c             | 106 +++++++++++
 sound/soc/qcom/qdsp6/audioreach.h             |  39 +++++
 sound/soc/qcom/qdsp6/q6apm-lpass-dais.c       |  15 ++
 sound/soc/qcom/qdsp6/q6apm.c                  |  11 +-
 sound/soc/qcom/qdsp6/q6prm-clocks.c           |  10 ++
 sound/soc/qcom/qdsp6/q6prm.h                  |  11 ++
 sound/soc/qcom/qdsp6/topology.c               |  34 +++-
 sound/soc/qcom/sc8280xp.c                     |  43 +++++
 23 files changed, 728 insertions(+), 220 deletions(-)
 create mode 100644 drivers/media/platform/qcom/iris/iris_platform_kaanapali.h

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index e22aade66262..6e907e4c8f2b 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -39,7 +39,7 @@ aliases {
 	};
 
 	chosen {
-		bootargs = "rdinit=/rescue/mainline-init panic=0 loglevel=7 log_buf_len=2M bootconfig";
+		bootargs = "rdinit=/rescue/mainline-init loglevel=7 log_buf_len=2M bootconfig";
 
 		/* The bootloader ramdisk carries the rescue and boot userspace. */
 		fdt-handoff {
@@ -243,7 +243,7 @@ llcc_lpi_mem: llcc-lpi@ff800000 {
 	};
 
 	sound {
-		compatible = "qcom,kaanapali-sndcard", "qcom,sm8450-sndcard";
+		compatible = "oneplus,iceland-sndcard", "qcom,kaanapali-sndcard", "qcom,sm8450-sndcard";
 		pinctrl-0 = <&i2s0_default>;
 		pinctrl-names = "default";
 
@@ -256,11 +256,16 @@ sound {
 				"TX SWR_INPUT1", "ADC2_OUTPUT",
 				"TX SWR_INPUT2", "ADC3_OUTPUT";
 
-		primary-i2s-dai-link {
-			link-name = "Primary MI2S Playback";
+		primary-tdm-dai-link {
+			link-name = "Primary TDM Playback";
 
 			cpu {
-				sound-dai = <&q6apmbedai PRIMARY_MI2S_RX>;
+				sound-dai = <&q6apmbedai PRIMARY_TDM_RX_0>;
+				/* stock's speaker back end: TDM, 8 slots x 32 bit, 48 kHz, all slots active */
+				dai-tdm-slot-num = <8>;
+				dai-tdm-slot-width = <32>;
+				dai-tdm-slot-tx-mask = <1 1 1 1 1 1 1 1>;
+				dai-tdm-slot-rx-mask = <1 1 1 1 1 1 1 1>;
 			};
 
 			codec {
@@ -355,12 +360,16 @@ wcn7860-pmu {
 		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
 		bt-enable-gpios = <&pmh0104_j_e1_gpios 5 GPIO_ACTIVE_HIGH>;
 
-		vddio-supply = <&vreg_l2g_1p8>;
+		/*
+		 * As stock's Wi-Fi node: AON from L2G (1.8 V), CX from S1J; the
+		 * board has no antenna-share supply (vddant).
+		 */
 		vddio1p2-supply = <&vreg_l3g_1p2>;
-		vddaon-supply = <&vreg_s1j_0p8>;
+		vddaon-supply = <&vreg_l2g_1p8>;
 		vdddig-supply = <&vreg_s2j_0p8>;
 		vddrfa1p2-supply = <&vreg_s7f_1p2>;
 		vddrfa1p8-supply = <&vreg_s8f_1p8>;
+		vddcx-supply = <&vreg_s1j_0p8>;
 
 		clocks = <&rpmhcc RPMH_RF_CLK1>;
 
@@ -873,7 +882,7 @@ regulators-5 {
 
 		vreg_s1j_0p8: smps1 {
 			regulator-name = "vreg_s1j_0p8";
-			regulator-min-microvolt = <400000>;
+			regulator-min-microvolt = <892000>;
 			regulator-max-microvolt = <1000000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
@@ -1254,6 +1263,18 @@ &pon_resin {
 	status = "okay";
 };
 
+&q6apmbedai {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/* the speakers' TDM port: LPASS drives bit clock and frame sync (stock: internal sync) */
+	dai@18 {
+		reg = <PRIMARY_TDM_RX_0>;
+		clocks = <&q6prmcc LPASS_CLK_ID_PRI_TDM_IBIT LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "bclk";
+	};
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/kaanapali/iceland/adsp.mbn",
 			"qcom/kaanapali/iceland/adsp_dtb.mbn";
@@ -1863,3 +1884,9 @@ cpu-map {
 		};
 	};
 };
+
+&iris {
+	firmware-name = "qcom/kaanapali/iceland/vpu40_2v.mbn";
+
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/kaanapali.dtsi b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
index 58ffa5833121..afaf67beecd5 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali.dtsi
+++ b/arch/arm64/boot/dts/qcom/kaanapali.dtsi
@@ -2772,6 +2772,144 @@ tcsr: clock-controller@1fc0000 {
 			#reset-cells = <1>;
 		};
 
+		iris: video-codec@2000000 {
+			compatible = "qcom,kaanapali-iris";
+
+			reg = <0x0 0x02000000 0x0 0xf0000>;
+
+			interrupts = <GIC_SPI 174 IRQ_TYPE_LEVEL_HIGH>;
+
+			power-domains = <&videocc VIDEO_CC_MVS0C_GDSC>,
+					<&videocc VIDEO_CC_MVS0_GDSC>,
+					<&rpmhpd RPMHPD_MXC>,
+					<&rpmhpd RPMHPD_MMCX>,
+					<&videocc VIDEO_CC_MVS0_VPP0_GDSC>,
+					<&videocc VIDEO_CC_MVS0_VPP1_GDSC>,
+					<&videocc VIDEO_CC_MVS0A_GDSC>;
+			power-domain-names = "venus",
+					     "vcodec0",
+					     "mxc",
+					     "mmcx",
+					     "vpp0",
+					     "vpp1",
+					     "apv";
+
+			operating-points-v2 = <&iris_opp_table>;
+
+			clocks = <&gcc GCC_VIDEO_AXI0_CLK>,
+				 <&videocc VIDEO_CC_MVS0C_CLK>,
+				 <&videocc VIDEO_CC_MVS0_CLK>,
+				 <&gcc GCC_VIDEO_AXI1_CLK>,
+				 <&videocc VIDEO_CC_MVS0C_FREERUN_CLK>,
+				 <&videocc VIDEO_CC_MVS0_FREERUN_CLK>,
+				 <&videocc VIDEO_CC_MVS0B_CLK>,
+				 <&videocc VIDEO_CC_MVS0_VPP0_CLK>,
+				 <&videocc VIDEO_CC_MVS0_VPP1_CLK>,
+				 <&videocc VIDEO_CC_MVS0A_CLK>;
+			clock-names = "iface",
+				      "core",
+				      "vcodec0_core",
+				      "iface1",
+				      "core_freerun",
+				      "vcodec0_core_freerun",
+				      "vcodec_bse",
+				      "vcodec_vpp0",
+				      "vcodec_vpp1",
+				      "vcodec_apv";
+
+			interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+					 &config_noc SLAVE_VENUS_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
+					<&mmss_noc MASTER_VIDEO_MVP QCOM_ICC_TAG_ALWAYS
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+			interconnect-names = "cpu-cfg",
+					     "video-mem";
+
+			memory-region = <&video_mem>;
+
+			resets = <&gcc GCC_VIDEO_AXI0_CLK_ARES>,
+				 <&gcc GCC_VIDEO_AXI1_CLK_ARES>,
+				 <&videocc VIDEO_CC_MVS0C_FREERUN_CLK_ARES>,
+				 <&videocc VIDEO_CC_MVS0_FREERUN_CLK_ARES>;
+			reset-names = "bus0",
+				      "bus1",
+				      "core_freerun_reset",
+				      "vcodec0_core_freerun_reset";
+
+			iommus = <&apps_smmu 0x1940 0x0>,
+				 <&apps_smmu 0x1943 0x0>,
+				 <&apps_smmu 0x1944 0x0>,
+				 <&apps_smmu 0x1a20 0x0>;
+
+			dma-coherent;
+
+			/*
+			 * IRIS firmware is signed by vendors, only
+			 * enable on boards where the proper signed firmware
+			 * is available.
+			 */
+			status = "disabled";
+
+			iris_opp_table: opp-table {
+				compatible = "operating-points-v2";
+
+				opp-240000000 {
+					opp-hz = /bits/ 64 <240000000 240000000
+							    240000000 360000000>;
+					required-opps = <&rpmhpd_opp_low_svs_d1>,
+							<&rpmhpd_opp_low_svs_d1>;
+				};
+
+				opp-338000000 {
+					opp-hz = /bits/ 64 <338000000 338000000
+							    338000000 507000000>;
+					required-opps = <&rpmhpd_opp_low_svs>,
+							<&rpmhpd_opp_low_svs>;
+				};
+
+				opp-420000000 {
+					opp-hz = /bits/ 64 <420000000 420000000
+							    420000000 630000000>;
+					required-opps = <&rpmhpd_opp_svs>,
+							<&rpmhpd_opp_svs>;
+				};
+
+				opp-444000000 {
+					opp-hz = /bits/ 64 <444000000 444000000
+							    444000000 666000000>;
+					required-opps = <&rpmhpd_opp_svs_l1>,
+							<&rpmhpd_opp_svs_l1>;
+				};
+
+				opp-533000000 {
+					opp-hz = /bits/ 64 <533000000 533000000
+							    533000000 800000000>;
+					required-opps = <&rpmhpd_opp_nom>,
+							<&rpmhpd_opp_nom>;
+				};
+
+				opp-630000000 {
+					opp-hz = /bits/ 64 <630000000 630000000
+							    630000000 1104000000>;
+					required-opps = <&rpmhpd_opp_turbo>,
+							<&rpmhpd_opp_turbo>;
+				};
+
+				opp-800000000 {
+					opp-hz = /bits/ 64 <800000000 630000000
+							    630000000 1260000000>;
+					required-opps = <&rpmhpd_opp_turbo_l0>,
+							<&rpmhpd_opp_turbo_l0>;
+				};
+
+				opp-1000000000 {
+					opp-hz = /bits/ 64 <1000000000 630000000
+							    850000000 1260000000>;
+					required-opps = <&rpmhpd_opp_turbo_l1>,
+							<&rpmhpd_opp_turbo_l1>;
+				};
+			};
+		};
+
 		videocc: clock-controller@20f0000 {
 			compatible = "qcom,kaanapali-videocc";
 			reg = <0x0 0x020f0000 0x0 0x10000>;
@@ -3298,7 +3436,7 @@ gpr {
 					compatible = "qcom,gpr";
 					qcom,glink-channels = "adsp_apps";
 					qcom,domain = <GPR_DOMAIN_ID_ADSP>;
-					qcom,intents = <512 20>;
+					qcom,intents = <512 20>, <1024 8>;
 					#address-cells = <1>;
 					#size-cells = <0>;
 
