+/*
+ * The manager waits in state 1 ("wait for source settings") until the host sets MANSCONF, and it clears
+ * MANSCONF itself when the TDM setup doesn't match the incoming frame. Set it after every power-up, once the TDM
+ * and tuning registers are in place, as the vendor driver does, and clear it before powering down.
+ */
+static int tfa9865_power_event(struct snd_soc_dapm_widget *w, struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+
+	switch (event) {
+	case SND_SOC_DAPM_POST_PMU:
+		return snd_soc_component_update_bits(component, TFA9865_SYS_CONTROL1,
+						     TFA9865_MANSCONF_MASK, TFA9865_MANSCONF_MASK) < 0 ? -EIO : 0;
+	case SND_SOC_DAPM_PRE_PMD:
+		return snd_soc_component_update_bits(component, TFA9865_SYS_CONTROL1,
+						     TFA9865_MANSCONF_MASK, 0) < 0 ? -EIO : 0;
+	}
+
+	return 0;
+}
