+/* the topology's maximum for a volume widget's control, or the module's full range if it has none */
+static unsigned int audioreach_pga_max_gain(struct snd_soc_dapm_widget *w)
+{
+	struct soc_mixer_control *mc;
+
+	if (w->num_kcontrols < 1 || !w->kcontrols[0])
+		return U16_MAX;
+
+	mc = (struct soc_mixer_control *)w->kcontrols[0]->private_value;
+
+	return mc ? mc->max : U16_MAX;
+}
